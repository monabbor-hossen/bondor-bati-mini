# .env.example — Bondor Bati Next.js environment variables
# Copy this file to .env.local and update with your local credentials.

# ── App Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database (MySQL / XAMPP) ─────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bondor_bati_site
DB_USERNAME=root
DB_PASSWORD=

# ── Mobile API Auth (Flutter App) ────────────────────────────────────────────
MOBILE_API_KEY=change-me-to-a-secure-secret-key

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
